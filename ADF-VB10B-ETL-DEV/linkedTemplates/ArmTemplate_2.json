										"type": "Expression"
									},
									"TableName": {
										"value": "@pipeline().parameters.TableName",
										"type": "Expression"
									}
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "IF_NEW_DATA_EXISTS",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "LKUP_MAX_VALUE",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@or(\n   equals(pipeline().parameters.LastLoadValue, null),\n   greater(\n      int(activity('LKUP_MAX_VALUE').output.firstRow.MaxValue),\n      int(pipeline().parameters.LastLoadValue)\n   )\n)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Copy_from_mssqlserver",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
